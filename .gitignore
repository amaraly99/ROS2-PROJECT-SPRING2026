.DS_Store
############################################################
# ROS2 / colcon
############################################################
build/
install/
log/

############################################################
# ROS2 message generation artifacts
############################################################
**/build/
**/install/
**/log/

############################################################
# Thirdparty compiled libraries
############################################################
src/**/Thirdparty/**/build/
src/**/Thirdparty/**/install/

############################################################
# OpenCV (built from source – ~4 GB)
############################################################
opencv/
opencv_contrib/

############################################################
# Core dumps
############################################################
core.*
**/core.*

############################################################
# OV²SLAM trajectory output files
############################################################
ov2slam_traj.txt
ov2slam_kfs_traj.txt
ov2slam_traj_kitti.txt
# Wildcard covers all trajectory variant names (e.g. wlc, wlc_opt, etc.)
ov2slam_*traj*.txt

############################################################
# Source backup directories (created during patching)
############################################################
src/**/src_backup_*/

############################################################
# Utility / one-off scripts
############################################################
fix_stream.py
frame.raw

############################################################
# Benchmark results / experiment data (CSVs, figures, run dirs)
############################################################
benchmarks/results/
*.csv

# Curated, aggregated results that BACK THE PAPER are published on purpose.
# They live in their own directory rather than in benchmarks/results/, because
# git cannot re-include a file whose parent directory is excluded — the rule
# above kills any negation under results/. Only the *.csv file rule applies
# here, and that one a negation can undo.
!benchmarks/paper_data/*.csv
!benchmarks/paper_data/**/*.csv

############################################################
# Model binaries (~700 MB — fetched, not committed)
############################################################
# NOTE: there is deliberately no bare `*.hef` rule. models/yolo26n_10h.hef is
# already tracked and is the default model the stack runs with; a blanket rule
# would only hide it from future updates. Ignore the bulk directories instead.
# See models/fetch_models.sh to obtain everything below.
models/hef/
models/onnx/
modeltest/

############################################################
# Manuscript (IEEE template ships its own licensed fonts; the
# paper itself is not part of the software artifact)
############################################################
paper/

############################################################
# Claude Code internal files
############################################################
.claude/

############################################################
# Datasets / bags / large files
############################################################
datasets/
bags/
*.db3
*.bag
*.mcap
*.zip
*.tar
*.tar.gz
*.vsix

############################################################
# Docker
############################################################
docker_data/
*.img

############################################################
# Python
############################################################
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
env/

############################################################
