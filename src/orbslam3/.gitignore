# Same convention as src/orbslam2/.gitignore: the vocabulary is a 47 MB blob that
# never changes, so it lives on disk but stays out of git (.git is already ~1 GB).
orb_slam3/Vocabulary/ORBvoc.txt
orb_slam3/Vocabulary/*.txt.tar.gz

