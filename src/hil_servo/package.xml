<?xml version="1.0"?>
<package format="3">
  <name>hil_servo</name>
  <version>1.0.0</version>
  <description>TS2 — the MATLAB sim-HIL proportional servoing controller as a
  ROS2 node. Shared FSM (servo_core) + decoupled proportional control law.</description>
  <maintainer email="amaraly304@gmail.com">team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>yolo_msgs</depend>
  <depend>servo_core</depend>

  <export><build_type>ament_cmake</build_type></export>
</package>